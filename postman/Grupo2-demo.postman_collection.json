            "description": "Reutilizó la clave para otra intención: error del cliente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pasajero\": \"Ana\",\n  \"conductor_id\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
