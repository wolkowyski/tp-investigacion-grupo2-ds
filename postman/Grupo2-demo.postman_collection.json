    {
      "name": "2 · Pagos con deduplicación (caso 2)",
      "item": [
        {
          "name": "Llega msg-V17: se paga",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pagos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pagos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_mensaje\": \"msg-V17\",\n  \"conductor_id\": 1,\n  \"monto\": 1500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"no es duplicado\", () => pm.expect(pm.response.json().duplicado).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Se REENTREGA msg-V17: se descarta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pagos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pagos"
              ]
            },
            "description": "Responde 200 igual: es el ACK, para que la cola deje de reentregarlo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_mensaje\": \"msg-V17\",\n  \"conductor_id\": 1,\n  \"monto\": 1500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"duplicado descartado, saldo 11500\", () => { const b = pm.response.json(); pm.expect(b.duplicado).to.eql(true); pm.expect(b.saldo).to.eql(11500); });"
                ]
              }
            }
          ]
        }
      ]
