    {
      "name": "1 · Reservas con Idempotency-Key (casos 1 y 5)",
      "item": [
        {
          "name": "Ana reserva sin header (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservas"
              ]
            },
            "description": "Sin Idempotency-Key el servidor no puede reconocer reintentos: lo rechaza.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pasajero\": \"Ana\",\n  \"conductor_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ana reserva a Carlos (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{claveAna}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservas"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pasajero\": \"Ana\",\n  \"conductor_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"reservaAna\", pm.response.json().reserva_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ana REINTENTA, misma clave (201 repetida)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{claveAna}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservas"
              ]
            },
            "description": "La app no recibió la respuesta y reintenta con la MISMA clave: no se crea otra reserva.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pasajero\": \"Ana\",\n  \"conductor_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"misma reserva que el primer intento\", () => pm.expect(pm.response.json().reserva_id).to.eql(Number(pm.collectionVariables.get(\"reservaAna\"))));",
                  "pm.test(\"header Idempotent-Replayed: true\", () => pm.response.to.have.header(\"Idempotent-Replayed\", \"true\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ana, misma clave con OTRO conductor (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
